# ── Environment Template ──────────────────────────────────────────────────────
# Copy this to .env and fill in real values before running docker compose.
# NEVER commit .env to version control.

# Database
POSTGRES_USER=admin
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
POSTGRES_DB=high_assurance

# Redis
REDIS_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# PASETO v4.public (Ed25519)
# Generate a private key with: python -c "from pyseto import Key; k = Key.new(version=4, purpose='public'); print(k.to_paserk())"
PASETO_PRIVATE_KEY=CHANGE_ME_GENERATE_WITH_PYSETO_KEY_NEW

# Grafana
GRAFANA_PASSWORD=admin

# Deployment
DEPLOY_ENV=development

# OpenTelemetry (optional — leave empty for console-only)
OTEL_ENDPOINT=
